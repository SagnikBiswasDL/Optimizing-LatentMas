+# SPDX-License-Identifier: Apache-2.0
+"""LatentMAS single-engine support for the vLLM fork.
+
+Latent-step requests feed realign(last_hidden) as the next inputs_embeds
+instead of a sampled token embedding, keep KV in-engine across agent role
+prompts, then decode the Judger normally.
+"""
+
+from vllm.latentmas.constants import LATENT_PLACEHOLDER_TOKEN_ID
+from vllm.latentmas.realign import (
+    apply_latent_realignment,
+    build_latent_realign_matrix,
+)
+from vllm.latentmas.state import (
+    LatentMASPhase,
+    LatentMASRequestState,
+    latent_mas_from_extra_args,
+)
+
+__all__ = [
+    "LATENT_PLACEHOLDER_TOKEN_ID",
+    "LatentMASPhase",
+    "LatentMASRequestState",
+    "apply_latent_realignment",
+    "build_latent_realign_matrix",
+    "latent_mas_from_extra_args",
+]
